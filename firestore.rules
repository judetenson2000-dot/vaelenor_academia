rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny-all catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidAcademicPaper(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 500 &&
             data.author is string && data.author.size() <= 200 &&
             data.abstract is string && data.abstract.size() <= 5000;
    }

    function isValidPaymentConfig(data) {
      return data.upiId is string && data.upiId.size() <= 100 &&
             data.payeeName is string && data.payeeName.size() <= 100;
    }

    // User Academic Papers
    match /users/{userId}/papers/{paperId} {
      allow get: if isOwner(userId) && isValidId(paperId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(paperId) &&
                       incoming().userId == request.auth.uid &&
                       isValidAcademicPaper(incoming());
      allow update: if isOwner(userId) && isValidId(paperId) &&
                       incoming().userId == existing().userId &&
                       isValidAcademicPaper(incoming());
      allow delete: if isOwner(userId) && isValidId(paperId);
    }

    // Public Academic Templates (Read-only for users, writable by admin)
    match /public_templates/{templateId} {
      allow get: if isValidId(templateId);
      allow list: if true;
      allow write: if isSignedIn();
    }

    // Settings Collection (Payment / QR Configuration)
    match /settings/{settingId} {
      allow get: if true;
      allow list: if true;
      allow write: if (settingId == 'payment' ? isValidPaymentConfig(incoming()) : isSignedIn());
    }
  }
}
